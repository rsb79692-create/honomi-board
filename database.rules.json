{
  "rules": {
    "honomi": {
      ".read": "auth != null",
      ".write": "auth != null",
      "tc5_records": {
        ".indexOn": [
          "date"
        ]
      }
    },
    "members": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('active').val() === true",
      "$uid": {
        ".write": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'ceo'",
        "role": {
          ".validate": "newData.val() === 'ceo' || newData.val() === 'mgr'"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "name": {
          ".validate": "newData.isString()"
        },
        "mail": {
          ".validate": "newData.isString()"
        },
        "rooms": {
          "$rid": {
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": false
        },
        ".validate": "newData.hasChildren(['role','active'])"
      }
    },
    "config": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('active').val() === true",
      ".write": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'ceo'"
    },
    "field": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('active').val() === true",
      ".write": "auth != null && root.child('members').child(auth.uid).child('active').val() === true"
    },
    "viewLinks": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && root.child('members').child(auth.uid).child('role').val() === 'ceo'",
      ".write": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && root.child('members').child(auth.uid).child('role').val() === 'ceo'",
      "$uid": {
        "token": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{22,64}$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        },
        ".validate": "newData.hasChildren(['token'])"
      }
    },
    "views": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && root.child('members').child(auth.uid).child('role').val() === 'ceo'",
      "$token": {
        ".read": "data.child('uid').exists() && root.child('viewLinks').child(data.child('uid').val()).child('token').val() === $token && root.child('members').child(data.child('uid').val()).child('active').val() === true",
        ".write": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && root.child('members').child(auth.uid).child('role').val() === 'ceo'",
        ".validate": "$token.matches(/^[A-Za-z0-9_-]{22,64}$/) && newData.hasChildren(['uid','updatedAt','rooms'])",
        "uid": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128 && !newData.val().contains('/')"
        },
        "who": {
          ".validate": "newData.isString()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "rooms": {
          ".validate": "newData.hasChildren()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'ceo' && root.child('members').child(auth.uid).child('active').val() === true",
      "$rid": {
        ".read": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && (root.child('members').child(auth.uid).child('role').val() === 'ceo' || data.child('members').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && root.child('members').child(auth.uid).child('role').val() === 'ceo'",
        "name": {
          ".validate": "newData.isString()"
        },
        "members": {
          "$uid": {
            ".validate": "newData.isBoolean()"
          }
        },
        "board": {
          "toCeo": {
            ".write": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && (root.child('members').child(auth.uid).child('role').val() === 'ceo' || root.child('rooms').child($rid).child('members').child(auth.uid).val() === true)"
          },
          "mgrAsk": {
            ".write": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && (root.child('members').child(auth.uid).child('role').val() === 'ceo' || root.child('rooms').child($rid).child('members').child(auth.uid).val() === true)"
          }
        }
      }
    }
  }
}
